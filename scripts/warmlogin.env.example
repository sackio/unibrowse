# Template for /home/ben/.secrets/unibrowse-warm.env ON SERVER3 — mode 600.
# ⛔ NAMES ONLY IN THIS REPO. Never commit a value here; the real file is
# host-local to server3 and is not in git.
#   install -d -m 700 /home/ben/.secrets
#   cp scripts/warmlogin.env.example /home/ben/.secrets/unibrowse-warm.env
#   chmod 600 /home/ben/.secrets/unibrowse-warm.env   # then fill it in
# Read by scripts/warmlogin.sh only, which pipes values over stdin and never
# prints one. ⛔ Do not add these to the container's `environment:` block —
# container env is readable by every seat on the host.
AMAZON_EMAIL=
AMAZON_PASSWORD=
EBAY_EMAIL=
EBAY_PASSWORD=
DOORDASH_EMAIL=
DOORDASH_PASSWORD=
